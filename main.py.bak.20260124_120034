import os
import base64
from pathlib import Path
from typing import Dict, Any, List

import decky
from settings import SettingsManager


class Plugin:
    def __init__(self):
        settings_dir = os.environ["DECKY_PLUGIN_SETTINGS_DIR"]
        self.settings = SettingsManager(name="settings", settings_directory=settings_dir)
        self.settings.read()

        runtime_dir = Path(os.environ["DECKY_PLUGIN_RUNTIME_DIR"])
        self.pdf_dir = runtime_dir / "pdfs"
        self.pdf_dir.mkdir(parents=True, exist_ok=True)

    async def get_pdf_dir(self) -> str:
        return str(self.pdf_dir)

    async def list_pdfs(self) -> List[Dict[str, Any]]:
        files: List[Dict[str, Any]] = []
        for p in self.pdf_dir.iterdir():
            if p.is_file() and p.suffix.lower() == ".pdf":
                st = p.stat()
                files.append({
                    "name": p.name,
                    "size": int(st.st_size),
                    "mtime": int(st.st_mtime),
                })
        files.sort(key=lambda x: x["name"].lower())
        return files

    async def load_pdf_base64(self, filename: str) -> str:
        safe_name = Path(filename).name
        path = self.pdf_dir / safe_name
        if not path.exists() or not path.is_file():
            raise FileNotFoundError(f"PDF not found: {safe_name}")

        data = path.read_bytes()
        return base64.b64encode(data).decode("utf-8")

    async def load_state(self) -> Dict[str, Any]:
        return {
            "last_pdf": self.settings.getSetting("last_pdf", ""),
            "last_page": int(self.settings.getSetting("last_page", 1)),
            "paged_mode": bool(self.settings.getSetting("paged_mode", True)),
            "zoom": float(self.settings.getSetting("zoom", 1.0)),
            "disable_worker": bool(self.settings.getSetting("disable_worker", True)),
        }

    async def save_state(
        self,
        last_pdf: str,
        last_page: int,
        paged_mode: bool,
        zoom: float,
        disable_worker: bool = True
    ) -> None:
        self.settings.setSetting("last_pdf", str(last_pdf))
        self.settings.setSetting("last_page", int(last_page))
        self.settings.setSetting("paged_mode", bool(paged_mode))
        self.settings.setSetting("zoom", float(zoom))
        self.settings.setSetting("disable_worker", bool(disable_worker))
        self.settings.commit()

    async def _main(self):
        pass

    async def _unload(self):
        pass
