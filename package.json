{
  "name": "decky-pdf-viewer",
  "version": "0.1.20",
  "description": "A Decky Loader Quick Access Menu PDF viewer for Steam Deck strategy guides.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "check": "tsc --noEmit",
    "test": "pytest",
    "package": "rollup -c && node scripts/package-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IANmO0ne/pdf-viewer.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "pdf",
    "reader",
    "strategy-guide"
  ],
  "author": "IANmO0ne",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/IANmO0ne/pdf-viewer/issues"
  },
  "homepage": "https://github.com/IANmO0ne/pdf-viewer#readme",
  "dependencies": {
    "@decky/api": "^1.1.3",
    "pdfjs-dist": "3.11.174",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.3",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "^5.1.20",
    "@types/webpack": "^5.28.5",
    "archiver": "^7.0.1",
    "react-router": "^5.3.4",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
