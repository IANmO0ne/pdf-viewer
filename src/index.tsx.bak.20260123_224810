import { useEffect, useMemo, useRef, useState } from "react";

import { call, definePlugin } from "@decky/api";
import {
  ButtonItem,
  DropdownItem,
  PanelSection,
  PanelSectionRow,
  ToggleField,
} from "@decky/ui";

import { Document, Page, pdfjs } from "react-pdf";

// Worker source (required if worker is enabled)
pdfjs.GlobalWorkerOptions.workerSrc = new URL(
  "pdfjs-dist/build/pdf.worker.min.mjs",
  import.meta.url
).toString();

const RENDER_TEXT_LAYER = false;
const RENDER_ANNOTATIONS = false;

type PdfEntry = { name: string; size: number; mtime: number };

type SavedState = {
  last_pdf: string;
  last_page: number;
  paged_mode: boolean;
  zoom: number;
  disable_worker: boolean;
};

async function backend<T>(method: string, ...args: any[]): Promise<T> {
  return await call<any[], T>(method as any, ...args);
}

function PdfViewerContent() {
  const [pdfDir, setPdfDir] = useState<string>("");
  const [pdfs, setPdfs] = useState<PdfEntry[]>([]);

  const [selectedPdf, setSelectedPdf] = useState<string>("");
  const [page, setPage] = useState<number>(1);
  const [pagedMode, setPagedMode] = useState<boolean>(true);
  const [zoom, setZoom] = useState<number>(1.0);
  const [disableWorker, setDisableWorker] = useState<boolean>(true);

  const [pdfB64, setPdfB64] = useState<string>("");
  const [numPages, setNumPages] = useState<number>(0);

  const [isSelecting, setIsSelecting] = useState<boolean>(true);
  const [autoResumeAllowed, setAutoResumeAllowed] = useState<boolean>(true);
  const [errMsg, setErrMsg] = useState<string>("");

  const scrollContainerRef = useRef<HTMLDivElement | null>(null);

  const pdfData = useMemo(() => {
    if (!pdfB64) return null;
    const bin = atob(pdfB64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes;
  }, [pdfB64]);

  // Apply worker mode deterministically whenever toggle changes
  useEffect(() => {
    (pdfjs as any).disableWorker = disableWorker;
  }, [disableWorker]);

  async function refreshList() {
    setErrMsg("");
    try {
      const dir = await backend<string>("get_pdf_dir");
      setPdfDir(dir);

      const list = await backend<PdfEntry[]>("list_pdfs");
      setPdfs(list);
    } catch (e: any) {
      setErrMsg(`Failed to refresh list: ${String(e?.message ?? e)}`);
    }
  }

  async function loadState() {
    setErrMsg("");
    try {
      const state = await backend<SavedState>("load_state");
      setSelectedPdf(state.last_pdf || "");
      setPage(state.last_page || 1);
      setPagedMode(state.paged_mode ?? true);
      setZoom(state.zoom || 1.0);
      setDisableWorker(state.disable_worker ?? true);
    } catch (e: any) {
      setErrMsg(`Failed to load saved state: ${String(e?.message ?? e)}`);
    }
  }

  async function persistState(next?: Partial<SavedState>) {
    const state: SavedState = {
      last_pdf: next?.last_pdf ?? selectedPdf,
      last_page: next?.last_page ?? page,
      paged_mode: next?.paged_mode ?? pagedMode,
      zoom: next?.zoom ?? zoom,
      disable_worker: next?.disable_worker ?? disableWorker,
    };

    try {
      await backend<void>(
        "save_state",
        state.last_pdf,
        state.last_page,
        state.paged_mode,
        state.zoom,
        state.disable_worker
      );
    } catch (e: any) {
      setErrMsg(`Failed to save state: ${String(e?.message ?? e)}`);
    }
  }

  async function openPdf(name: string) {
    setErrMsg("");
    setPdfB64("");
    setNumPages(0);

    setIsSelecting(false);

    setSelectedPdf(name);
    await persistState({ last_pdf: name, last_page: 1 });

    try {
      (pdfjs as any).disableWorker = disableWorker;

      const b64 = await backend<string>("load_pdf_base64", name);
      setPdfB64(b64);
      setPage(1);
    } catch (e: any) {
      setErrMsg(`Failed to load PDF "${name}": ${String(e?.message ?? e)}`);
      setIsSelecting(true);
      setSelectedPdf("");
      setPdfB64("");
      setNumPages(0);
    }
  }

  function clampPage(p: number) {
    const max = numPages || 1;
    return Math.max(1, Math.min(max, p));
  }

  function nextPage() {
    const p = clampPage(page + 1);
    setPage(p);
    void persistState({ last_page: p });
  }

  function prevPage() {
    const p = clampPage(page - 1);
    setPage(p);
    void persistState({ last_page: p });
  }

  function zoomIn() {
    const z = Math.min(4.0, +(zoom + 0.25).toFixed(2));
    setZoom(z);
    void persistState({ zoom: z });
  }

  function zoomOut() {
    const z = Math.max(0.5, +(zoom - 0.25).toFixed(2));
    setZoom(z);
    void persistState({ zoom: z });
  }

  function goToPicker() {
    setAutoResumeAllowed(false);
    setIsSelecting(true);

    setPdfB64("");
    setNumPages(0);
    setSelectedPdf("");
    setErrMsg("");
  }

  useEffect(() => {
    void (async () => {
      await refreshList();
      await loadState();
    })();
  }, []);

  // One-time auto resume only (never while user is selecting)
  useEffect(() => {
    if (!autoResumeAllowed) return;
    if (!selectedPdf) return;
    if (pdfs.length === 0) return;
    if (!isSelecting) return;

    const exists = pdfs.some((p) => p.name === selectedPdf);
    if (!exists) return;

    setAutoResumeAllowed(false);
    void openPdf(selectedPdf);
  }, [autoResumeAllowed, selectedPdf, pdfs, isSelecting]);

  // Scroll mode: scroll to saved page after render
  useEffect(() => {
    if (!pdfData || pagedMode) return;
    const el = scrollContainerRef.current?.querySelector<HTMLDivElement>(
      `[data-page="${page}"]`
    );
    el?.scrollIntoView({ block: "start" });
  }, [pdfData, pagedMode, page]);

  // Picker view
  if (isSelecting) {
    return (
      <PanelSection title="PDF Viewer">
        <PanelSectionRow>
          <div style={{ fontSize: 12, opacity: 0.85, lineHeight: "16px" }}>
            Place PDF files here:
            <div style={{ marginTop: 6, fontFamily: "monospace", wordBreak: "break-all" }}>
              {pdfDir || "(loading...)"}
            </div>
          </div>
        </PanelSectionRow>

        <PanelSectionRow>
          <ButtonItem layout="below" onClick={() => void refreshList()}>
            Refresh PDF list
          </ButtonItem>
        </PanelSectionRow>

        <PanelSectionRow>
          <ToggleField
            label="Disable PDF worker (compatibility mode)"
            description="If PDFs fail to load, keep this enabled."
            checked={disableWorker}
            onChange={(v) => {
              setDisableWorker(v);
              void persistState({ disable_worker: v });
            }}
          />
        </PanelSectionRow>

        <PanelSectionRow>
          <DropdownItem
            label="Select PDF"
            rgOptions={pdfs.map((p) => ({ label: p.name, data: p.name }))}
            selectedOption={undefined}
            onChange={(opt) => {
              const name = String(opt.data);
              void openPdf(name);
            }}
            disabled={pdfs.length === 0}
          />
        </PanelSectionRow>

        {pdfs.length === 0 ? (
          <PanelSectionRow>
            <div style={{ fontSize: 12, opacity: 0.8 }}>
              No PDFs found yet. Copy files into the folder above, then press Refresh.
            </div>
          </PanelSectionRow>
        ) : null}

        {errMsg ? (
          <PanelSectionRow>
            <div style={{ fontSize: 12, opacity: 0.9 }}>
              <div style={{ fontWeight: 600, marginBottom: 4 }}>Error</div>
              <div style={{ fontFamily: "monospace", whiteSpace: "pre-wrap" }}>{errMsg}</div>
            </div>
          </PanelSectionRow>
        ) : null}
      </PanelSection>
    );
  }

  // Viewer view
  return (
    <PanelSection title={`PDF Viewer${selectedPdf ? `: ${selectedPdf}` : ""}`}>
      <PanelSectionRow>
        <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
          <ButtonItem layout="inline" onClick={zoomIn}>Zoom +</ButtonItem>
          <ButtonItem layout="inline" onClick={zoomOut}>Zoom -</ButtonItem>
          <ButtonItem layout="inline" onClick={prevPage} disabled={pagedMode && page <= 1}>Previous PG</ButtonItem>
          <ButtonItem layout="inline" onClick={nextPage} disabled={pagedMode && numPages > 0 && page >= numPages}>Next PG</ButtonItem>
          <ButtonItem layout="inline" onClick={goToPicker}>Select PDF</ButtonItem>
        </div>
      </PanelSectionRow>

      <PanelSectionRow>
        <ToggleField
          label="Scroll / PG by PG"
          description={pagedMode ? "Checked: one page at a time" : "Unchecked: continuous scroll"}
          checked={pagedMode}
          onChange={(v) => {
            setPagedMode(v);
            void persistState({ paged_mode: v });
          }}
        />
      </PanelSectionRow>

      <PanelSectionRow>
        <ToggleField
          label="Disable PDF worker (compatibility mode)"
          description="If PDFs fail to load, keep this enabled."
          checked={disableWorker}
          onChange={(v) => {
            setDisableWorker(v);
            void persistState({ disable_worker: v });
          }}
        />
      </PanelSectionRow>

      <PanelSectionRow>
        <div style={{ width: "100%" }}>
          <Document
            file={pdfData ? { data: pdfData } : undefined}
            onLoadSuccess={({ numPages: np }: { numPages: number }) => {
              setNumPages(np);
              const p = clampPage(page);
              setPage(p);
              void persistState({ last_page: p });
            }}
            loading={<div style={{ fontSize: 12, opacity: 0.8 }}>Loading PDF...</div>}
            error={<div style={{ fontSize: 12, opacity: 0.8 }}>Failed to load PDF.</div>}
            noData={<div style={{ fontSize: 12, opacity: 0.8 }}>No PDF loaded.</div>}
          >
            {pdfData ? (
              pagedMode ? (
                <div style={{ overflow: "hidden" }}>
                  <Page
                    pageNumber={page}
                    scale={zoom}
                    renderTextLayer={RENDER_TEXT_LAYER}
                    renderAnnotationLayer={RENDER_ANNOTATIONS}
                  />
                </div>
              ) : (
                <div ref={scrollContainerRef} style={{ maxHeight: 420, overflowY: "auto", paddingRight: 6 }}>
                  {Array.from({ length: numPages }, (_, i) => {
                    const pageNumber = i + 1;
                    return (
                      <div key={pageNumber} data-page={pageNumber} style={{ marginBottom: 12 }}>
                        <Page
                          pageNumber={pageNumber}
                          scale={zoom}
                          renderTextLayer={RENDER_TEXT_LAYER}
                          renderAnnotationLayer={RENDER_ANNOTATIONS}
                        />
                      </div>
                    );
                  })}
                </div>
              )
            ) : null}
          </Document>

          <div style={{ fontSize: 12, opacity: 0.8, marginTop: 8 }}>
            Page {pagedMode ? page : Math.max(page, 1)} / {numPages} | Zoom {zoom.toFixed(2)}x
          </div>

          {errMsg ? (
            <div style={{ fontSize: 12, opacity: 0.9, marginTop: 8 }}>
              <div style={{ fontWeight: 600, marginBottom: 4 }}>Error</div>
              <div style={{ fontFamily: "monospace", whiteSpace: "pre-wrap" }}>{errMsg}</div>
            </div>
          ) : null}
        </div>
      </PanelSectionRow>
    </PanelSection>
  );
}

export default definePlugin(() => {
  return {
    name: "PDF Viewer",
    title: <div className="Title">PDF Viewer</div>,
    content: <PdfViewerContent />,
    icon: <div style={{ fontSize: 16 }}>📄</div>,
  };
});
