import os
import base64
from pathlib import Path
from typing import Dict, Any, List

import decky  # new name; old decky_plugin still works too :contentReference[oaicite:13]{index=13}
from settings import SettingsManager  # Decky-provided persistence :contentReference[oaicite:14]{index=14}


class Plugin:
    def __init__(self):
        # Where Decky recommends storing settings (persistent). :contentReference[oaicite:15]{index=15}
        settings_dir = os.environ["DECKY_PLUGIN_SETTINGS_DIR"]
        self.settings = SettingsManager(name="settings", settings_directory=settings_dir)
        self.settings.read()  # Load settings.json into memory. :contentReference[oaicite:16]{index=16}

        # Where Decky recommends storing runtime data (persistent folder, but “data-like”). :contentReference[oaicite:17]{index=17}
        runtime_dir = Path(os.environ["DECKY_PLUGIN_RUNTIME_DIR"])
        self.pdf_dir = runtime_dir / "pdfs"
        self.pdf_dir.mkdir(parents=True, exist_ok=True)  # Ensure folder exists.

    async def get_pdf_dir(self) -> str:
        # Frontend uses this to show “Place PDFs here: ...”
        return str(self.pdf_dir)

    async def list_pdfs(self) -> List[Dict[str, Any]]:
        # Return metadata so UI can show a clean list.
        files = []
        for p in self.pdf_dir.iterdir():
            if p.is_file() and p.suffix.lower() == ".pdf":
                stat = p.stat()
                files.append({
                    "name": p.name,
                    "size": stat.st_size,
                    "mtime": int(stat.st_mtime),
                })
        files.sort(key=lambda x: x["name"].lower())
        return files

    async def load_pdf_base64(self, filename: str) -> str:
        # Read entire PDF and return base64.
        # For very large PDFs this is heavier; it’s the simplest correct first version.
        safe_name = Path(filename).name  # Prevent directory traversal.
        path = self.pdf_dir / safe_name
        if not path.exists():
            raise FileNotFoundError(f"PDF not found: {safe_name}")

        data = path.read_bytes()
        return base64.b64encode(data).decode("utf-8")

    async def load_state(self) -> Dict[str, Any]:
        # Provide defaults if nothing saved yet.
        return {
            "last_pdf": self.settings.getSetting("last_pdf", ""),
            "last_page": int(self.settings.getSetting("last_page", 1)),
            "paged_mode": bool(self.settings.getSetting("paged_mode", True)),
            "zoom": float(self.settings.getSetting("zoom", 1.0)),
        }

    async def save_state(self, last_pdf: str, last_page: int, paged_mode: bool, zoom: float) -> None:
        # Save frequently so unexpected closes still resume correctly.
        self.settings.setSetting("last_pdf", str(last_pdf))
        self.settings.setSetting("last_page", int(last_page))
        self.settings.setSetting("paged_mode", bool(paged_mode))
        self.settings.setSetting("zoom", float(zoom))
        self.settings.commit()  # Flush to disk. :contentReference[oaicite:18]{index=18}

    async def _main(self):
        # Long-running startup work would go here.
        pass

    async def _unload(self):
        # Cleanup when plugin unloads.
        pass

    async def save_state_extra(self, disable_worker: bool) -> None:
        # Store extra client flags without changing the original save_state signature.
        self.settings.setSetting("disable_worker", bool(disable_worker))
        self.settings.commit()
